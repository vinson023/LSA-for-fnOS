#!/bin/bash

# LSA Pre-Install Script for fnOS
# This script runs BEFORE files are copied to target directory

echo "Preparing to install LSI Storage Authority..."
echo "App name: $TRIM_APPNAME"
echo "App version: $TRIM_APPVER"

# Pre-check: verify system architecture
ARCH=$(uname -m)
if [ "$ARCH" != "x86_64" ]; then
    echo "LSA requires x86_64 architecture, detected: $ARCH" > "$TRIM_TEMP_LOGFILE"
    exit 1
fi

echo "Pre-install checks passed"
exit 0